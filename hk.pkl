/// hk owns every git hook in this repository.
///
/// Install them with `mise run setup` (which runs `hk install --mise`). Never run
/// `bd hooks install`: it points `core.hooksPath` at `.beads/hooks`, which disables
/// every hook hk installed. Beads instead runs as hk steps below, calling the same
/// `bd hooks run <hook>` entry point beads' own shims call.
///
/// The hooks match what `workbench project init` writes for a consumer, plus Workbench's own
/// formatters and linters. The hk version here must match the `hk` pin in mise.toml.
amends "package://github.com/jdx/hk/releases/download/v2.8.1/hk@2.8.1#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.8.1/hk@2.8.1#/Builtins.pkl"

/// Files another tool owns and rewrites. `bd` regenerates `.beads/metadata.json`
/// and `.beads/issues.jsonl`, and it writes `metadata.json` with no trailing
/// newline, which `newlines` would otherwise fail on after every `mise run setup`.
exclude = List(".beads/**")

/// Formatters and linters. `check`, `fix` and `pre-commit` all share this set, so a
/// clean `hk check --all` in CI means a clean pre-commit locally.
local linters = new Mapping<String, Step> {
    ["trailing_whitespace"] = Builtins.trailing_whitespace
    ["newlines"] = Builtins.newlines
    ["check_merge_conflict"] = Builtins.check_merge_conflict

    // `actionlint` is pinned in mise.toml, so the hook, `mise run check` and CI all check the
    // workflows with the same version.
    ["actionlint"] = Builtins.actionlint

    // dprint formats Markdown (prose unwrapped), JSON, YAML, and TOML; settings live in
    // dprint.json. No formatter checks the Hugo templates or CSS.
    ["dprint"] = Builtins.dprint

    ["cargo_fmt"] = Builtins.cargo_fmt

    // Every target, every warning an error: the builtin's default checks only the library
    // and lets warnings through.
    ["cargo_clippy"] = (Builtins.cargo_clippy) {
        check = "cargo clippy --all-targets --quiet -- -D warnings"
        fix = "cargo clippy --all-targets --fix --allow-dirty --allow-staged --quiet -- -D warnings"
    }
}

/// Syncs this machine's Beads replica where work crosses machines: before a push, and after
/// a pull, merge, or rebase. A sync that does not succeed prints its outcome and never blocks
/// git.
local beadsSync: Step = new {
    check = "mise run beads:sync"
    allow_failure = true
    output_summary = "combined"
}

/// `bd hooks run` exits 3 when the beads database is not initialized. Beads' own
/// shims treat that as success so a fresh clone can commit before `mise run setup`
/// has run; these steps do the same.
hooks {
    ["check"] {
        steps = linters
    }

    ["fix"] {
        fix = true
        steps = linters
    }

    ["pre-commit"] {
        fix = true
        stage = true
        stash = "git"
        steps = (linters) {
            ["beads"] {
                check = "bd hooks run pre-commit || [ $? -eq 3 ]"
                exclusive = true
            }
        }
    }

    ["commit-msg"] {
        steps {
            ["scoped-commit"] {
                check = "workbench commits check --output text --message-file {{commit_msg_file}}"
            }
        }
    }

    ["prepare-commit-msg"] {
        steps {
            ["beads"] {
                check = "bd hooks run prepare-commit-msg {{hook_args}} || [ $? -eq 3 ]"
            }
        }
    }

    // No hook runs `mise run check`: CI runs it on every push, and agents wait for CI before
    // marking a pull request ready or merging it.
    ["pre-push"] {
        steps {
            ["beads-sync"] = beadsSync
            ["beads"] {
                depends = "beads-sync"
                check = "bd hooks run pre-push {{hook_args}} || [ $? -eq 3 ]"
            }
        }
    }

    ["post-checkout"] {
        steps {
            ["beads"] {
                check = "bd hooks run post-checkout {{hook_args}} || [ $? -eq 3 ]"
            }
        }
    }

    ["post-merge"] {
        steps {
            ["beads"] {
                check = "bd hooks run post-merge {{hook_args}} || [ $? -eq 3 ]"
            }
            ["beads-sync"] = (beadsSync) {
                depends = "beads"
            }
        }
    }

    // `git pull --rebase` runs `post-rewrite`, not `post-merge`. Git passes `rebase` or `amend`;
    // an amend rewrites only local work, so it skips the sync.
    ["post-rewrite"] {
        steps {
            ["beads-sync"] = (beadsSync) {
                check = "[ \"{{hook_args}}\" != rebase ] || mise run beads:sync"
            }
        }
    }
}
