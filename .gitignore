# macOS
.DS_Store
Thumbs.db

# Editor / IDE
.vscode/
.idea/

# Rust build output, and the release archives `mise run package` builds.
/target/
/dist/
/artifacts/

# The Workbench package link: machine-local, recreated by `mise run setup` here and by
# `mise install` in a consumer.
.workbench

# mise — machine-local overrides and their lockfiles. mise.toml and mise.lock are committed.
mise.local.toml
mise.*.local.toml
.mise.local.toml
.mise/locks/mise.local/

# hk — machine-local hook overrides. hk.pkl is committed.
hk.local.pkl

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*

# Environment
.env
.env.*
!.env.example

# Logs and temp
*.log
*.pid
*.tmp
